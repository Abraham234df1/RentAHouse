@model RentaDepartamentosWeb.Models.Departamento

@{
    ViewData["Title"] = "Detalles del Departamento";
}

<div class="page-shell">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="section-title">
                <i class="bi bi-info-circle"></i>
                <span>Detalle del inmueble</span>
            </div>
            <h2 class="mb-1">Departamento #@Model.Id</h2>
            <p class="text-muted mb-0">Revisa toda la información registrada para este inmueble.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Regresar</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h4 class="mb-1">@Model.Direccion</h4>
                            <p class="text-muted mb-0">@Model.Colonia · @Model.Ciudad</p>
                        </div>
                        <span class="badge @(Model.Estado == "Disponible" ? "bg-success" : Model.Estado == "Rentado" ? "bg-danger" : "bg-warning text-dark")">@Model.Estado</span>
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Dirección</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Direccion</dd>

                        <dt class="col-sm-4 text-muted">Colonia</dt>
                        <dd class="col-sm-8">@Model.Colonia</dd>

                        <dt class="col-sm-4 text-muted">Ciudad</dt>
                        <dd class="col-sm-8">@Model.Ciudad</dd>

                        <hr class="my-3">

                        <dt class="col-sm-4 text-muted">Habitaciones</dt>
                        <dd class="col-sm-8">@Model.Habitaciones</dd>

                        <dt class="col-sm-4 text-muted">Baños</dt>
                        <dd class="col-sm-8">@Model.Banios</dd>

                        <dt class="col-sm-4 text-muted">Precio de renta</dt>
                        <dd class="col-sm-8 text-success fw-bold">@Model.PrecioRenta.ToString("C2")</dd>

                        <hr class="my-3">

                        <dt class="col-sm-4 text-muted">Arrendatario</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Arrendatario) ? "-" : Model.Arrendatario)</dd>

                        <dt class="col-sm-4 text-muted">Fecha de inicio de renta</dt>
                        <dd class="col-sm-8">@(Model.FechaInicioRenta?.ToString("dd/MM/yyyy") ?? "-")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Regresar</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
                </div>
            </div>
        </div>
    </div>
</div>
