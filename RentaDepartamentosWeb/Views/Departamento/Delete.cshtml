@model RentaDepartamentosWeb.Models.Departamento

@{
    ViewData["Title"] = "Confirmar Eliminación";
}

<div class="page-shell">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-3 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        <h3 class="mb-0">¿Confirmar eliminación?</h3>
                    </div>
                    <p class="text-danger fw-semibold">¿Está seguro de que desea eliminar este departamento? Esta acción no se puede deshacer.</p>

                    <div class="bg-light p-3 rounded-4 mb-3">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">ID</dt>
                            <dd class="col-sm-8">@Model.Id</dd>

                            <dt class="col-sm-4 text-muted">Dirección</dt>
                            <dd class="col-sm-8">@Model.Direccion</dd>

                            <dt class="col-sm-4 text-muted">Colonia</dt>
                            <dd class="col-sm-8">@Model.Colonia</dd>

                            <dt class="col-sm-4 text-muted">Ciudad</dt>
                            <dd class="col-sm-8">@Model.Ciudad</dd>

                            <dt class="col-sm-4 text-muted">Precio de renta</dt>
                            <dd class="col-sm-8 text-success fw-bold">@Model.PrecioRenta.ToString("C2")</dd>

                            <dt class="col-sm-4 text-muted">Estado</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(Model.Estado == "Disponible" ? "bg-success" : Model.Estado == "Rentado" ? "bg-danger" : "bg-warning text-dark")">@Model.Estado</span>
                            </dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
