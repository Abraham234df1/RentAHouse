@model IEnumerable<RentaDepartamentosWeb.Models.Departamento>

@{
    ViewData["Title"] = "Buscar Departamentos";
    var ciudad = ViewBag.Ciudad as string;
    var colonia = ViewBag.Colonia as string;
    var precioMin = ViewBag.PrecioMin as decimal?;
    var precioMax = ViewBag.PrecioMax as decimal?;
    var estado = ViewBag.Estado as string;
}

<div class="page-shell">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="section-title">
                <i class="bi bi-search"></i>
                <span>Búsqueda avanzada</span>
            </div>
            <h2 class="mb-1">Buscar departamentos</h2>
            <p class="text-muted mb-0">Filtra propiedades por ubicación, precio y estado.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al listado</a>
    </div>

    <div class="card mb-4 border-0">
        <div class="card-body">
            <form asp-action="Buscar" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Ciudad</label>
                    <input type="text" name="ciudad" class="form-control" value="@ciudad" placeholder="Ej. Mérida..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Colonia</label>
                    <input type="text" name="colonia" class="form-control" value="@colonia" placeholder="Ej. Centro..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Precio mínimo ($)</label>
                    <input type="number" name="precioMin" class="form-control" value="@precioMin" placeholder="Sin mínimo" step="0.01" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Precio máximo ($)</label>
                    <input type="number" name="precioMax" class="form-control" value="@precioMax" placeholder="Sin máximo" step="0.01" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="">-- Todos --</option>
                        <option value="Disponible" selected="@(estado == "Disponible" ? "selected" : null)">Disponible</option>
                        <option value="Rentado" selected="@(estado == "Rentado" ? "selected" : null)">Rentado</option>
                        <option value="Mantenimiento" selected="@(estado == "Mantenimiento" ? "selected" : null)">Mantenimiento</option>
                    </select>
                </div>
                <div class="col-12 text-end mt-3">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-filter"></i> Filtrar</button>
                    <a asp-action="Buscar" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-counterclockwise"></i> Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="table-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Dirección</th>
                    <th>Colonia</th>
                    <th>Ciudad</th>
                    <th class="text-center">Hab.</th>
                    <th class="text-center">Baños</th>
                    <th class="text-end">Precio renta</th>
                    <th class="text-center">Estado</th>
                    <th>Arrendatario</th>
                    <th class="text-center">Inicio renta</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="11" class="empty-state">No se encontraron departamentos que coincidan con los filtros aplicados.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Direccion</td>
                            <td>@item.Colonia</td>
                            <td>@item.Ciudad</td>
                            <td class="text-center">@item.Habitaciones</td>
                            <td class="text-center">@item.Banios</td>
                            <td class="text-end">@item.PrecioRenta.ToString("C2")</td>
                            <td class="text-center">
                                @if (item.Estado == "Disponible")
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                                else if (item.Estado == "Rentado")
                                {
                                    <span class="badge bg-danger">Rentado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Mantenimiento</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.Arrendatario) ? "-" : item.Arrendatario)</td>
                            <td class="text-center">@(item.FechaInicioRenta?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Ver detalles">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
