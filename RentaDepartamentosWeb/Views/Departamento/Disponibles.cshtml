@model IEnumerable<RentaDepartamentosWeb.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos Disponibles";
}

<div class="page-shell">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="section-title">
                <i class="bi bi-check-circle"></i>
                <span>Disponibilidad inmediata</span>
            </div>
            <h2 class="mb-1">Departamentos disponibles</h2>
            <p class="text-muted mb-0">Mostrando únicamente propiedades con estado Disponible para renta inmediata.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al listado</a>
            <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nuevo departamento</a>
        </div>
    </div>

    <div class="alert alert-light border" role="alert">
        Mostrando únicamente departamentos con estado <strong>Disponible</strong> para su renta inmediata.
    </div>

    <div class="table-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Dirección</th>
                    <th>Colonia</th>
                    <th>Ciudad</th>
                    <th class="text-center">Hab.</th>
                    <th class="text-center">Baños</th>
                    <th class="text-end">Precio renta</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="empty-state">No hay departamentos disponibles en este momento.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Direccion</td>
                            <td>@item.Colonia</td>
                            <td>@item.Ciudad</td>
                            <td class="text-center">@item.Habitaciones</td>
                            <td class="text-center">@item.Banios</td>
                            <td class="text-end">@item.PrecioRenta.ToString("C2")</td>
                            <td class="text-center">
                                <span class="badge bg-success">Disponible</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Ver detalles">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
