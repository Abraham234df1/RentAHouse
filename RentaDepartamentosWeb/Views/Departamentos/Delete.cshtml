@model RentaDepartamentosWeb.Models.Departamento

@{
    ViewData["Title"] = "Confirmar Eliminación";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> ¿Confirmar Eliminación?</h4>
                </div>
                <div class="card-body">
                    <p class="text-danger font-weight-bold">¿Está seguro de que desea eliminar este departamento? Esta acción no se puede deshacer.</p>
                    
                    <div class="bg-light p-3 rounded mb-3">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">ID</dt>
                            <dd class="col-sm-8">@Model.Id</dd>

                            <dt class="col-sm-4 text-muted">Dirección</dt>
                            <dd class="col-sm-8">@Model.Direccion</dd>

                            <dt class="col-sm-4 text-muted">Colonia</dt>
                            <dd class="col-sm-8">@Model.Colonia</dd>

                            <dt class="col-sm-4 text-muted">Ciudad</dt>
                            <dd class="col-sm-8">@Model.Ciudad</dd>

                            <dt class="col-sm-4 text-muted">Precio de Renta</dt>
                            <dd class="col-sm-8 text-success">@Model.PrecioRenta.ToString("C2")</dd>

                            <dt class="col-sm-4 text-muted">Estado</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(Model.Estado == "Disponible" ? "bg-success" : Model.Estado == "Rentado" ? "bg-danger" : "bg-warning text-dark")">@Model.Estado</span>
                            </dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        <!-- ID oculto requerido para el POST -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Resumen de errores de eliminación -->
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
