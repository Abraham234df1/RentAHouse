@model IEnumerable<RentaDepartamentosWeb.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos Disponibles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success"><i class="bi bi-check-circle"></i> Departamentos Disponibles</h2>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al Listado Completo</a>
            <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nuevo Departamento</a>
        </div>
    </div>

    <div class="alert alert-info" role="alert">
        Mostrando únicamente departamentos con estado <strong>Disponible</strong> para su renta inmediata.
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Dirección</th>
                    <th>Colonia</th>
                    <th>Ciudad</th>
                    <th class="text-center">Hab.</th>
                    <th class="text-center">Baños</th>
                    <th class="text-end">Precio Renta</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No hay departamentos disponibles en este momento.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Direccion</td>
                            <td>@item.Colonia</td>
                            <td>@item.Ciudad</td>
                            <td class="text-center">@item.Habitaciones</td>
                            <td class="text-center">@item.Banios</td>
                            <td class="text-end">@item.PrecioRenta.ToString("C2")</td>
                            <td class="text-center">
                                <span class="badge bg-success">Disponible</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Ver Detalles">
                                        <i class="bi bi-eye-fill"></i> Detalles
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                        <i class="bi bi-pencil-fill"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i> Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
